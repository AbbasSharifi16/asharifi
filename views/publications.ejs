<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Publications - Abbas Sharifi' %></title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Merriweather:wght@300;400;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Publications by Abbas Sharifi in Water Resource Engineering, Storm Sewer Systems, and Computational Fluid Dynamics">
    <meta name="keywords" content="Publications, Research Papers, Water Resources, CFD, Academic Articles">
    <meta name="author" content="Abbas Sharifi">
</head>
<body>
    <%- include('partials/navbar') %>

    <!-- Main Content -->
    <main>
        <!-- Publications Hero -->
        <section class="publications-hero">
            <div class="container">
                <div class="publications-hero-content">
                    <h1 class="publications-title">Publications & Research Output</h1>
                    <p class="publications-subtitle">
                        Peer-reviewed articles, conference proceedings, and research contributions in water resource engineering, 
                        computational fluid dynamics, and interdisciplinary studies
                    </p>
                    
                    <div class="publication-stats">
                        <div class="pub-stat">
                            <span class="pub-number"><%= scholarMetrics.publications %></span>
                            <span class="pub-label">Publications</span>
                        </div>
                        <div class="pub-stat">
                            <span class="pub-number"><%= scholarMetrics.citations.toLocaleString() %></span>
                            <span class="pub-label">Citations</span>
                        </div>
                        <div class="pub-stat">
                            <span class="pub-number"><%= scholarMetrics.hIndex %></span>
                            <span class="pub-label">H-Index</span>
                        </div>
                        <div class="pub-stat">
                            <span class="pub-number"><%= scholarMetrics.i10Index %></span>
                            <span class="pub-label">i10-Index</span>
                        </div>
                    </div>
                    
                    <div style="margin-top: var(--space-3); font-size: var(--text-sm); opacity: 0.8;">
                        <i class="fas fa-sync-alt"></i> Last updated: <%= new Date(scholarMetrics.lastUpdated).toLocaleString() %>
                    </div>
                </div>
            </div>
        </section>

<!-- Auto-Fetched Publications from Google Scholar -->
<section class="all-publications" style="display: none;">
    <div class="container">
        <h2 class="section-title">
            <i class="fas fa-graduation-cap"></i> 
            Publication List
        </h2>
        
        <% if (publications && publications.length > 0) { %>
            <div class="publication-category" data-category="all">
                <div class="publications-list">
                    <% publications.forEach((pub, index) => { %>
                        <div class="publication-item" data-year="<%= pub.year %>">
                            <div class="publication-number"><%= index + 1 %>.</div>
                            <div class="publication-content">
                                <h4>
                                    <a href="<%= pub.link %>" target="_blank" rel="noopener">
                                        <%= pub.title %>
                                    </a>
                                </h4>
                                <p class="authors"><%= pub.authors %></p>
                                <% if (pub.venue) { %>
                                    <p class="journal"><%= pub.venue %></p>
                                <% } %>
                                <div class="publication-tags">
                                    <% if (pub.year) { %>
                                        <span class="tag primary"><i class="fas fa-calendar"></i> <%= pub.year %></span>
                                    <% } %>
                                    <% if (pub.citedBy > 0) { %>
                                        <span class="tag secondary"><i class="fas fa-quote-right"></i> <%= pub.citedBy %> citations</span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: var(--space-16); color: var(--text-secondary);">
                <i class="fas fa-spinner fa-spin" style="font-size: 2rem; margin-bottom: var(--space-4);"></i>
                <p>Loading publications from Google Scholar...</p>
            </div>
        <% } %>
    </div>
</section>

<!-- Manual Publications Archive -->
