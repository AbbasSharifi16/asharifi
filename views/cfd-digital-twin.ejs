    <style>
        /* CFD Digital Twin Page Styles */
        .cfd-section-heading {
            font-family: var(--font-family-secondary);
            font-size: var(--text-2xl);
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: var(--space-4);
            padding-bottom: var(--space-2);
            border-bottom: 3px solid var(--primary-color);
            display: inline-block;
        }

        .cfd-section-desc {
            color: var(--text-secondary);
            font-size: var(--text-base);
            line-height: 1.8;
            margin-bottom: var(--space-6);
            max-width: 900px;
        }

        .cfd-overview-card {
            background: var(--background-secondary);
            border-radius: var(--radius-xl);
            padding: var(--space-8);
            box-shadow: var(--shadow-md);
        }

        .cfd-overview-text {
            color: var(--text-primary);
            font-size: var(--text-base);
            line-height: 1.8;
            margin-bottom: var(--space-6);
        }

        .cfd-overview-text code {
            background: rgba(25, 118, 210, 0.1);
            color: var(--primary-color);
            padding: 0.1em 0.4em;
            border-radius: 4px;
            font-size: 0.9em;
        }

        .cfd-feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--space-4);
        }

        .cfd-feature-item {
            display: flex;
            align-items: flex-start;
            gap: var(--space-3);
            background: var(--background-primary);
            border-radius: var(--radius-lg);
            padding: var(--space-4);
            box-shadow: var(--shadow-sm);
            border-left: 4px solid var(--primary-color);
        }

        .cfd-feature-item i {
            color: var(--primary-color);
            font-size: 1.2rem;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .cfd-feature-item span {
            color: var(--text-primary);
            font-size: var(--text-sm);
            line-height: 1.5;
        }

        .cfd-video-full {
            border-radius: var(--radius-xl);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            background: #000;
        }

        .cfd-video-player {
            width: 100%;
            display: block;
            max-height: 600px;
            object-fit: contain;
            background: #000;
        }

        .cfd-video-caption {
            text-align: center;
            color: var(--text-secondary);
            font-size: var(--text-sm);
            padding: var(--space-3) var(--space-4);
            background: var(--background-secondary);
            margin: 0;
            font-style: italic;
        }

        .cfd-video-pair {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-6);
        }

        .cfd-video-pair-item {
            border-radius: var(--radius-xl);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            background: #000;
        }

        .cfd-video-pair-item .cfd-video-player {
            max-height: 400px;
        }

        .cfd-tech-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: var(--space-6);
        }

        .cfd-tech-card {
            background: var(--background-secondary);
            border-radius: var(--radius-xl);
            padding: var(--space-6);
            box-shadow: var(--shadow-md);
            border-top: 4px solid var(--primary-color);
        }

        .cfd-tech-card h3 {
            font-size: var(--text-lg);
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: var(--space-4);
            display: flex;
            align-items: center;
            gap: var(--space-2);
        }

        .cfd-tech-card h3 i {
            color: var(--primary-color);
        }

        .cfd-tech-card ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .cfd-tech-card ul li {
            color: var(--text-secondary);
            font-size: var(--text-sm);
            padding: var(--space-2) 0;
            border-bottom: 1px solid var(--border-color);
            line-height: 1.5;
        }

        .cfd-tech-card ul li:last-child {
            border-bottom: none;
        }

        @media (max-width: 768px) {
            .cfd-video-pair {
                grid-template-columns: 1fr;
            }

