    <style>
        /* GDSL Digital Twin — research-statement layout */
        /* Content column spans the same width as the hero container, so its left
           and right edges line up with the hero on both sides. */
        .paper-container {
            max-width: 1200px;
        }

        /* Opening statement */
        .stmt-lede {
            margin-bottom: var(--space-10);
            padding-bottom: var(--space-8);
            border-bottom: 1px solid var(--divider-color);
        }

        .stmt-lede p {
            font-size: var(--text-lg);
            line-height: 1.75;
            color: var(--text-primary);
        }

        /* Sections (unnumbered, first-person narrative).
           Overrides the global `section { padding: var(--space-16) 0 }` so the
           gap between sections is a single, consistent step. */
        .paper-section {
            padding: 0;
            margin-bottom: var(--space-8);
        }

        .paper-section:last-of-type {
            margin-bottom: 0;
        }

        .paper-section h2 {
            font-size: var(--text-xl);
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: var(--space-5);
            padding-bottom: var(--space-2);
            border-bottom: 2px solid var(--text-primary);
        }

        .paper-subsection h3 {
            font-size: var(--text-lg);
            font-weight: 600;
            color: var(--text-primary);
            margin: var(--space-8) 0 var(--space-3);
        }

        .paper-subsection:first-of-type h3 {
            margin-top: 0;
        }

        .paper-subsection p {
            font-size: var(--text-base);
            line-height: 1.8;
            color: var(--text-primary);
            text-align: justify;
            margin-bottom: var(--space-4);
        }

        .paper-subsection code {
            background: var(--background-secondary);
            padding: 0.1em 0.4em;
            border-radius: 3px;
            font-size: 0.9em;
            color: var(--text-primary);
        }

        /* Figures */
        .paper-figure {
            margin: var(--space-6) 0 0;
        }

        .paper-figure video,
        .paper-figure img {
            width: 100%;
            display: block;
            background: #000;
            border: 1px solid var(--border-color);
        }

        .paper-figure-caption {
            font-size: var(--text-sm);
            color: var(--text-secondary);
            line-height: 1.6;
            text-align: center;
            margin-top: var(--space-3);
            padding: 0 var(--space-2);
        }

        .paper-figure-pair {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-6);
        }

        @media (max-width: 768px) {
            .paper-figure-pair {
                grid-template-columns: 1fr;
            }
        }
    </style>
