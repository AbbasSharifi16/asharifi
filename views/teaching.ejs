<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Teaching - Abbas Sharifi' %></title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Teaching experience and courses by Abbas Sharifi in Civil Engineering, Environmental Engineering, and Fluid Mechanics">
    <meta name="keywords" content="Teaching, Education, Civil Engineering, Environmental Engineering, Fluid Mechanics">
    <meta name="author" content="Abbas Sharifi">
</head>
<body>
    <%- include('partials/navbar') %>

    <!-- Main Content -->
    <main>
        <!-- Teaching Hero -->
        <section class="teaching-hero">
            <div class="container">
                <div class="teaching-hero-content">
                    <h1 class="teaching-title">Teaching & Mentoring</h1>
                    <p class="teaching-subtitle">
                        Passionate about education and knowledge transfer in engineering, fostering the next generation 
                        of researchers and professionals in water resource engineering and computational sciences
                    </p>
                </div>
            </div>
        </section>

<!-- Teaching Experience -->
<section class="teaching-experience">
    <div class="container">
        <h2 class="section-title">Teaching Experience</h2>
        
        <div class="teaching-timeline">
            <div class="teaching-item">
                <div class="teaching-marker"></div>
                <div class="teaching-content">
                    <div class="teaching-header">
                        <h3>Teaching Assistant</h3>
                        <span class="teaching-period">Jan 2022 - May 2024</span>
                    </div>
                    <h4>Florida International University</h4>
                    
                    <div class="courses-by-semester">
                        <div class="semester">
                            <h5>Spring 2024</h5>
                            <ul>
                                <li>Fluid Mechanics</li>
                                <li>Environmental Engineering for Global Sustainability</li>
                            </ul>
                        </div>
                        
                        <div class="semester">
                            <h5>Summer 2023</h5>
                            <ul>
                                <li>Fluid Mechanics</li>
                            </ul>
                        </div>
                        
                        <div class="semester">
                            <h5>Summer 2022</h5>
                            <ul>
                                <li>Introduction to Environmental Engineering</li>
                                <li>Environmental Laboratory</li>
                            </ul>
                        </div>
                        
                        <div class="semester">
                            <h5>Spring 2022</h5>
                            <ul>
                                <li>Environmental Engineering for Global Sustainability</li>
                                <li>Air Pollution Engineering</li>
                                <li>Wastewater Treatment Engineering</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="teaching-item">
                <div class="teaching-marker"></div>
                <div class="teaching-content">
                    <div class="teaching-header">
                        <h3>Laboratory Manager</h3>
                        <span class="teaching-period">Oct 2016 - Jun 2017</span>
                    </div>
                    <h4>Urmia University of Technology</h4>
                    <p>Managed the Fluid Mechanics laboratory and supported Fluid Mechanics course instruction</p>
                </div>
            </div>
            
            <div class="teaching-item">
                <div class="teaching-marker"></div>
                <div class="teaching-content">
                    <div class="teaching-header">
                        <h3>Instructor</h3>
                        <span class="teaching-period">Dec 2015 - Jun 2016</span>
                    </div>
                    <h4>Urmia University of Technology</h4>
                    <div class="courses-taught">
                        <ul>
                            <li>OpenFOAM Programming</li>
                            <li>C++ Programming</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Course Details -->
<section class="course-details">
    <div class="container">
        <h2 class="section-title">Course Expertise</h2>
        
        <div class="courses-grid">
            <div class="course-card">
                <div class="course-icon">
                    <i class="fas fa-water"></i>
                </div>
                <h3>Fluid Mechanics</h3>
                <p>
                    Fundamental principles of fluid statics and dynamics, including viscous flow, 
                    turbulence, and practical applications in engineering systems.
                </p>
                <div class="course-topics">
                    <span class="topic">Flow Analysis</span>
                    <span class="topic">Hydraulics</span>
                    <span class="topic">CFD Basics</span>
                </div>
            </div>
            
            <div class="course-card">
                <div class="course-icon">
                    <i class="fas fa-leaf"></i>
                </div>
                <h3>Environmental Engineering</h3>
                <p>
                    Comprehensive coverage of environmental systems, sustainability principles, 
                    and engineering solutions for global environmental challenges.
                </p>
                <div class="course-topics">
                    <span class="topic">Sustainability</span>
                    <span class="topic">Water Systems</span>
                    <span class="topic">Green Engineering</span>
                </div>
            </div>
            
            <div class="course-card">
                <div class="course-icon">
                    <i class="fas fa-wind"></i>
                </div>
                <h3>Air Pollution Engineering</h3>
                <p>
                    Air quality management, pollution control technologies, and atmospheric 
                    chemistry with focus on engineering solutions.
                </p>
                <div class="course-topics">
                    <span class="topic">Air Quality</span>
                    <span class="topic">Control Systems</span>
                    <span class="topic">Monitoring</span>
                </div>
            </div>
            
            <div class="course-card">
                <div class="course-icon">
                    <i class="fas fa-recycle"></i>
                </div>
                <h3>Wastewater Treatment</h3>
                <p>
                    Design and operation of wastewater treatment systems, including biological 
                    and chemical treatment processes.
                </p>
                <div class="course-topics">
                    <span class="topic">Treatment Design</span>
                    <span class="topic">Process Control</span>
                    <span class="topic">Water Reuse</span>
                </div>
            </div>
            
            <div class="course-card">
                <div class="course-icon">
                    <i class="fas fa-code"></i>
                </div>
                <h3>Computational Methods</h3>
                <p>
                    Programming and computational techniques for engineering applications, 
                    including OpenFOAM and C++ programming.
                </p>
                <div class="course-topics">
                    <span class="topic">OpenFOAM</span>
                    <span class="topic">C++</span>
                    <span class="topic">Numerical Methods</span>
                </div>
            </div>
            
            <div class="course-card">
                <div class="course-icon">
                    <i class="fas fa-flask"></i>
                </div>
                <h3>Environmental Laboratory</h3>
                <p>
                    Hands-on laboratory experience with environmental testing, instrumentation, 
                    and data analysis techniques.
                </p>
                <div class="course-topics">
                    <span class="topic">Testing Methods</span>
                    <span class="topic">Instrumentation</span>
                    <span class="topic">Data Analysis</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Mentoring Experience -->
<section class="mentoring">
    <div class="container">
        <h2 class="section-title">Mentoring & Professional Development</h2>
        
        <div class="mentoring-content">
            <div class="mentoring-stats">
                <div class="mentoring-stat">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-content">
                        <h3>84 Papers</h3>
                        <p>Peer reviewed across 28 journals</p>
                    </div>
                </div>
                
                <div class="mentoring-stat">
                    <div class="stat-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <div class="stat-content">
                        <h3>Academy Graduate</h3>
                        <p>Peer-Reviewing in Web of Science</p>
                    </div>
                </div>
                
                <div class="mentoring-stat">
                    <div class="stat-icon">
                        <i class="fas fa-edit"></i>
                    </div>
                    <div class="stat-content">
                        <h3>Guest Editor</h3>
                        <p>2 Special Issues</p>
                    </div>
                </div>
            </div>
            
            <div class="mentoring-activities">
                <h3>Professional Activities</h3>
                
                <div class="activity-list">
                    <div class="activity-item">
                        <i class="fas fa-star"></i>
                        <div>
                            <h4>Academy Graduate & Mentor for Peer-Reviewing Papers</h4>
                            <span>Web of Science (2019 - Present)</span>
                            <p>Certified mentor for academic peer review processes</p>
                        </div>
                    </div>
                    
                    <div class="activity-item">
                        <i class="fas fa-edit"></i>
                        <div>
                            <h4>Guest Editor - Journal of Healthcare Engineering</h4>
                            <span>Special Issue: "Complexity Systems for Scheduling in Healthcare" (Aug 2022 - May 2024)</span>
                            <p>Led editorial process for interdisciplinary research publication<br>
                            <a href="https://www.hindawi.com/journals/jhe/si/489193/" target="_blank" rel="noopener" style="color: var(--primary-color); text-decoration: none;">
                                <i class="fas fa-external-link-alt"></i> View Special Issue
                            </a></p>
                        </div>
                    </div>
                    
                    <div class="activity-item">
                        <i class="fas fa-edit"></i>
                        <div>
                            <h4>Guest Editor - Pharmaceutics</h4>
                            <span>Special Issue: "Advances in Drug Targeting Chemistry and Magnetic Fluid Dynamics for Enhanced Therapeutic Efficacy" (Present)</span>
                            <p>Leading editorial process for cutting-edge research in drug delivery systems<br>
                            <a href="https://www.mdpi.com/journal/pharmaceutics/special_issues/08NGNF3V1N" target="_blank" rel="noopener" style="color: var(--primary-color); text-decoration: none;">
                                <i class="fas fa-external-link-alt"></i> View Special Issue
                            </a></p>
                        </div>
                    </div>
                    
                    <div class="activity-item">
                        <i class="fas fa-users"></i>
                        <div>
                            <h4>Advisory Board Member</h4>
                            <span>2nd International Conference on AI Science and Applications (CAISAIS 2023)</span>
                            <p>Provided strategic guidance for international conference</p>
                        </div>
                    </div>
                    
                    <div class="activity-item">
                        <i class="fas fa-server"></i>
                        <div>
                            <h4>HPC System Implementation Project Leader</h4>
                            <span>Urmia University of Technology (Mar 2016)</span>
                            <p>Led design and implementation of High Performance Computing system using Linux clustering</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Teaching Philosophy -->
<section class="teaching-philosophy">
    <div class="container">
        <div class="philosophy-content">
            <div class="philosophy-text">
                <h2 class="section-title">Teaching Philosophy</h2>
                <p class="philosophy-intro">
                    My teaching approach is grounded in the belief that engineering education should bridge 
                    theoretical knowledge with practical application, fostering critical thinking and innovation.
                </p>
                
                <div class="philosophy-principles">
                    <div class="principle">
                        <div class="principle-icon">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <div class="principle-content">
                            <h3>Hands-on Learning</h3>
                            <p>
                                Emphasizing laboratory work and practical applications to reinforce theoretical concepts 
                                and develop problem-solving skills.
                            </p>
                        </div>
                    </div>
                    
                    <div class="principle">
                        <div class="principle-icon">
                            <i class="fas fa-brain"></i>
                        </div>
                        <div class="principle-content">
                            <h3>Critical Thinking</h3>
                            <p>
                                Encouraging students to question, analyze, and synthesize information to develop 
                                innovative solutions to complex engineering challenges.
                            </p>
                        </div>
                    </div>
                    
                    <div class="principle">
                        <div class="principle-icon">
                            <i class="fas fa-globe"></i>
                        </div>
                        <div class="principle-content">
                            <h3>Global Perspective</h3>
                            <p>
                                Integrating sustainability and global awareness into engineering education to prepare 
                                students for worldwide challenges.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="philosophy-image">
                <img src="/img/lab_image.jpg" alt="Teaching and Laboratory Environment" class="philosophy-img">
            </div>
        </div>
    </div>
</section>

<style>
/* Teaching Page Styles */
.teaching-hero {
    background: var(--background-secondary);
    color: var(--text-primary);
    padding: var(--space-12) 0 var(--space-10);
    margin-top: 64px;
    border-bottom: 1px solid var(--divider-color);
}

.teaching-hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
}

.teaching-title {
    font-family: var(--font-family-primary);
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
}

.teaching-subtitle {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
}

.current-position {
    padding: var(--space-12) 0;
}

.position-card {
    background: var(--background-primary);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    max-width: 900px;
    margin: 0 auto;
}

.position-header {
    background: var(--background-secondary);
    padding: var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.position-info h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
}

.position-info h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: var(--space-2);
}

.institution {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
}

.position-status {
    background: var(--secondary-color);
    color: white;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: var(--space-4);
}

.period {
    color: var(--text-light);
    font-weight: 500;
    font-size: var(--text-sm);
}

.position-icon {
    width: 60px;
    height: 60px;
    background: var(--primary-light);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
}

.position-icon i {
    font-size: var(--text-3xl);
    color: var(--primary-color);
}

.position-description {
    padding: var(--space-6);
}

.position-description p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-6);
}

.responsibilities h4 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
}

.responsibilities ul {
    list-style: none;
    padding: 0;
}

.responsibilities li {
    padding: var(--space-2) 0;
    color: var(--text-secondary);
    position: relative;
    padding-left: var(--space-6);
}

.responsibilities li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--secondary-color);
    font-weight: bold;
}

.teaching-experience {
    padding: var(--space-12) 0;
    background: var(--background-secondary);
}

.teaching-timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-left: var(--space-8);
}

.teaching-timeline::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #7c3aed;
}

.teaching-item {
    position: relative;
    margin-bottom: var(--space-10);
    background: var(--background-primary);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
}

.teaching-item:last-child {
    margin-bottom: 0;
}

.teaching-marker {
    position: absolute;
    left: -12px;
    top: var(--space-8);
    width: 16px;
    height: 16px;
    background: #7c3aed;
    border: 3px solid var(--background-primary);
    border-radius: var(--radius-full);
    z-index: 1;
}

.teaching-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-4);
}

.teaching-header h3 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
}

.teaching-period {
    color: var(--text-light);
    font-weight: 500;
    font-size: var(--text-sm);
}

.teaching-content h4 {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--primary-color);
    margin-bottom: var(--space-4);
}

.courses-by-semester {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
}

.semester h5 {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--border-color);
}

.semester ul {
    list-style: none;
    padding: 0;
}

.semester li {
    padding: var(--space-1) 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
}

.courses-taught ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
}

.courses-taught li {
    background: var(--primary-light);
    color: var(--primary-color);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
}

.course-details {
    padding: var(--space-12) 0;
}

.courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--space-6);
}

.course-card {
    background: var(--background-primary);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transition: var(--transition-base);
    border-top: 4px solid var(--primary-color);
}

.course-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.course-icon {
    width: 48px;
    height: 48px;
    background: var(--primary-light);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
}

.course-icon i {
    font-size: var(--text-xl);
    color: var(--primary-color);
}

.course-card h3 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
}

.course-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
}

.course-topics {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
}

.topic {
    background: var(--background-secondary);
    color: var(--text-secondary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 500;
}

.mentoring {
    padding: var(--space-12) 0;
    background: var(--background-secondary);
}

.mentoring-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-16);
}

.mentoring-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
}

.mentoring-stat {
    display: flex;
    gap: var(--space-3);
    background: var(--background-primary);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
}

.stat-icon {
    width: 40px;
    height: 40px;
    background: #7c3aed;
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: var(--text-lg);
    flex-shrink: 0;
}

.stat-content h3 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
}

.stat-content p {
    color: var(--text-secondary);
    font-size: var(--text-xs);
}

.mentoring-activities h3 {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
}

.activity-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
}

.activity-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
}

.activity-item i {
    font-size: var(--text-lg);
    color: #7c3aed;
    margin-top: var(--space-1);
    flex-shrink: 0;
}

.activity-item h4 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
}

.activity-item span {
    color: var(--primary-color);
    font-weight: 500;
    font-size: var(--text-xs);
    display: block;
    margin-bottom: var(--space-2);
}

.activity-item p {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    line-height: 1.6;
}

.teaching-philosophy {
    padding: var(--space-12) 0;
}

.philosophy-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-16);
    align-items: center;
}

.philosophy-intro {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-8);
}

.philosophy-principles {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
}

.principle {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
}

.principle-icon {
    width: 40px;
    height: 40px;
    background: var(--accent-color);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.principle-icon i {
    font-size: var(--text-lg);
    color: var(--text-primary);
}

.principle-content h3 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
}

.principle-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: var(--text-sm);
}

.philosophy-img {
    width: 100%;
